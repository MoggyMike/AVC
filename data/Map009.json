{"id":4,"name":"EV004","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":316,"characterName":"","characterIndex":0,"direction":2,"pattern":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Book Title: Factions & Corruption"]},{"code":401,"indent":0,"parameters":["Which section to read?"]},{"code":102,"indent":0,"parameters":[["The Corruption","Skull Clan","Shadow Cult","Love Tyrants","???","Close Book"],5,0,2,0]},{"code":402,"indent":0,"parameters":[0,"The Corruption"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Unknown when it appeared, but it triggered a massive chain"]},{"code":401,"indent":1,"parameters":["of events, causing the factions below to be created amongst"]},{"code":401,"indent":1,"parameters":["the chaos that the corruption wrecks upon the world."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Five crystals appeared around the world spilling corruption"]},{"code":401,"indent":1,"parameters":["into the world, infecting every living thing. Common animals"]},{"code":401,"indent":1,"parameters":["such as chickens are now considered as dangerous as some"]},{"code":401,"indent":1,"parameters":["predators and require cautious action to deal with."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Not everyone gets infected, only those that wander away"]},{"code":401,"indent":1,"parameters":["from safe locations, or are slain by the infected will"]},{"code":401,"indent":1,"parameters":["become one. Most notibly the elite guards of the light"]},{"code":401,"indent":1,"parameters":["palace have disappeared and never returned."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["All adventurers that travel out are to do so in trios"]},{"code":401,"indent":1,"parameters":["or squads. Survival is top priority, the palace cannot"]},{"code":401,"indent":1,"parameters":["afford more adventurers to fall into the infection and"]},{"code":401,"indent":1,"parameters":["add to the corruptions' army."]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"Skull Clan"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["After the corruption started, the light palace prison was"]},{"code":401,"indent":1,"parameters":["directly struck and invaded. In the mist of chaos, several"]},{"code":401,"indent":1,"parameters":["criminals escaped and founded the skull clan."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["The intentions of the skull clan is unknown, but are a"]},{"code":401,"indent":1,"parameters":["direct threat to the light palace. They were last seen"]},{"code":401,"indent":1,"parameters":["slaughtering any adventurers that they run into."]},{"code":401,"indent":1,"parameters":["If you see any of them, kill them on sight."]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[2,"Shadow Cult"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["After some weeks when the corruption spread, the shadow"]},{"code":401,"indent":1,"parameters":["cult was first spotted emerging from portals. It is unknown"]},{"code":401,"indent":1,"parameters":["if they are directly linked, but they are always seen around"]},{"code":401,"indent":1,"parameters":["the infected and protecting the corruption."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["If you see any, gather any data you can on them."]},{"code":401,"indent":1,"parameters":["Permission is granted to kill should they attack."]},{"code":101,"inde