{"id":1,"name":"EV001","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":316,"characterName":"","characterIndex":0,"direction":2,"pattern":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Book Title: Buffs & Debuffs 101"]},{"code":401,"indent":0,"parameters":["Which section to read?"]},{"code":102,"indent":0,"parameters":[["DoT (Burn, Turrets, Bombs)","Turn Skips (Freeze, Stun)","Parameter (De)buffs","???","???","Close Book"],5,0,2,0]},{"code":402,"indent":0,"parameters":[0,"DoT (Burn, Turrets, Bombs)"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["All forms of DoT states will always ignore damage reduction."]},{"code":401,"indent":1,"parameters":["Guarding does not reduce DoT damage, neither does applying"]},{"code":401,"indent":1,"parameters":["a shield. Taunting gives 20% damage reduction, DoT will also"]},{"code":401,"indent":1,"parameters":["ignore this."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Most DoTs apply an additional effect ontop of damage."]},{"code":401,"indent":1,"parameters":["Burn reduces (magic) defense by 20%."]},{"code":401,"indent":1,"parameters":["Shock makes the victim take 5% more damage."]},{"code":401,"indent":1,"parameters":["Poison reduces incoming HP/MP healing, etc.."]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"Turn Skips (Freeze, Stun)"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Most turn skips will skip at most 2 turns."]},{"code":401,"indent":1,"parameters":["Some states will be removed if you attack."]},{"code":401,"indent":1,"parameters":["Freeze does not break, but reduces damage by 65%."]},{"code":401,"indent":1,"parameters":["Stun will be removed if you attack."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Some form of turn skips like exhaustion will not be removed"]},{"code":401,"indent":1,"parameters":["if attacked."]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[2,"Parameter (De)buffs"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Parameters is your 8 basic stats: MAXHP, MAXMP, ATK, DEF,"]},{"code":401,"indent":1,"parameters":["MAT, MDF, AGI, and LUK."]},{"code":401,"indent":1,"parameters":["Buffing or debuffing a parameter will usually last 5 turns"]},{"code":401,"indent":1,"parameters":["and can be stacked twice, up to 150% or 50% of the stat."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Some states can also change the parameter stats such as"]},{"code":401,"indent":1,"parameters":["trip, applying -90% agility. This is multipliciative so"]},{"code":401,"indent":1,"parameters":["having double agility down and trip is -95% agility."]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[3,"???"]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[4,"???"]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[5,"Close Book"]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":false}],"x":5,"y":5},
{"id":2,"name":"EV002","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":316,"characterName":"","characterIndex":0,"direction":2,"pattern":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Book Title: MP & TP 101"]},{"code":401,"indent":0,"parameters":["Which section to read?"]},{"code":102,"indent":0,"parameters":[["MP (Magic)","TP (Special)","???","???","???","Close Book"],5,0,2,0]},{"code":402,"indent":0,"parameters":[0,"MP (Magic)"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["MP is magic points, used for casting spells."]},{"code":401,"indent":1,"parameters":["Very few characters can use magic, so it's possible"]},{"code":401,"indent":1,"parameters":["to have a party without using MP if needed."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Spells require MP to cast in battle."]},{"code":401,"indent":1,"parameters":["Most basic spells are very cheap and can be spammed."]},{"code":401,"indent":1,"parameters":["Some advanced spells however will cost a significant"]},{"code":401,"indent":1,"parameters":["amount of MP and you may need to use a mana potion."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["One benefit with MP over TP is that you can start every"]},{"code":401,"indent":1,"parameters":["fight with full MP. Beware of enemies that drain MP however."]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"TP (Special)"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["TP is tension points. Getting damaged or performing a basic"]},{"code":401,"indent":1,"parameters":["attack/guard will give you TP. TP does not scale on levelup"]},{"code":401,"indent":1,"parameters":["and remains at a fixed max 100."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["You start every battle with 0-25 TP randomly. Due to the"]},{"code":401,"indent":1,"parameters":["scarcity of TP, most skills cost under 25 TP. However,"]},{"code":401,"indent":1,"parameters":["higher damaging or performing skills will cost 25+ TP."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["A benefit TP has over MP is the ability to make a comeback."]},{"code":401,"indent":1,"parameters":["If a character faints, they gain a massive amount of TP."]},{"code":401,"indent":1,"parameters":["All characters that use TP will eventually get the TP boost"]},{"code":401,"indent":1,"parameters":["skill. You can spend a turn to increase TP gain by 50%."]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[2,"???"]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[3,"???"]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[4,"???"]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[5,"Close Book"]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":false}],"x":7,"y":5},
